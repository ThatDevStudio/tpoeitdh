generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ApiCache {
  id String @id @default(cuid())

  requestHash    String
  requestPath    String
  requestQuery   Json   @db.JsonB
  requestBody    Json   @db.JsonB
  requestHeaders Json   @db.JsonB

  responseBody    Json @db.JsonB
  responseHeaders Json @db.JsonB

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime @default(now())

  @@index([requestHash], type: Hash)
}

model ApiCollectionCache {
  id String @id @default(cuid())

  collectionHash    String
  collectionSource  String
  collectionName    String
  collectionOptions Json   @db.JsonB
  collectionBody    Json   @db.JsonB

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime @default(now())

  @@index([collectionHash], type: Hash)
}
