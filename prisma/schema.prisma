generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ApiCache {
  id String @id @default(cuid())

  host    String
  version String

  requestHash    String
  requestPath    String
  requestMethod  String
  requestQuery   Json   @db.JsonB
  requestBody    Json   @db.JsonB
  requestHeaders Json   @db.JsonB

  responseBody    Json @db.JsonB
  responseHeaders Json @db.JsonB
  responseCode    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestHash], type: Hash)
}
